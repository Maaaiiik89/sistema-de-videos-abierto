# Texto con saltos de línea normales en el repositorio
* text=auto

# Windows necesita estos con CRLF (un .bat con LF puede fallar al hacer doble clic)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios: nunca se tocan
*.mp3 binary
*.wav binary
*.m4a binary
*.mp4 binary
*.webm binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary

# No van dentro del zip que se publica
.github/ export-ignore
